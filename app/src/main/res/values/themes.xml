<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础主题(带 ActionBar,内部用) -->
    <style name="Theme.MyNote" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 无 ActionBar 主题(页面用) -->
    <style name="Theme.MyNote.NoActionBar" parent="Theme.MyNote">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 锁屏数字键盘按钮 -->
    <style name="LockKey">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:background">@drawable/lock_key_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">24sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- PDF 工具按钮 -->
    <style name="PdfToolBtn">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 玻璃对话框：API 31+ 系统级 windowBlurBehind 真模糊对话框后面的内容；
         低版本回退为高不透明度磨砂底（见 drawable/dialog_glass_bg.xml）。
         values-v31/themes.xml 覆盖追加 blur 属性。

         鸿蒙适配不在本样式里做：所有调用点统一走 GlassCompat.dialogTheme(context)，
         由它在运行时判定是否支持 windowBlurBehind，不支持则切换到 GlassDialogSolid。
         因此这里保持原值不动，原生 Android 观感不受影响。 -->
    <style name="GlassDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/dialog_glass_bg</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.10</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- 玻璃对话框·实心底：供不支持背景模糊的设备（鸿蒙等）运行时降级使用。
         与 GlassDialog 唯一差别是背景不透明，圆角/描边/dim 保持一致。 -->
    <style name="GlassDialogSolid" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/dialog_glass_solid_bg</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- 伪装计算器按钮 -->
    <style name="FakeCalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:backgroundTint">#2C2C2E</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>
