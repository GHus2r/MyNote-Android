<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1E"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="bottom">

    <!-- 显示区域 -->
    <TextView
        android:id="@+id/fake_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="56sp"
        android:fontFamily="sans-serif-light"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp" />

    <!-- 计算器按钮 -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:layout_marginBottom="16dp">

        <!-- Row 1: C, DEL, ÷, × -->
        <Button
            android:id="@+id/fake_btn_clear"
            style="@style/FakeCalcButton"
            android:text="C"
            android:textColor="#FF6B6B" />

        <Button
            android:id="@+id/fake_btn_del"
            style="@style/FakeCalcButton"
            android:text="⌫"
            android:textColor="#FFD93D" />

        <Button
            android:id="@+id/fake_btn_div"
            style="@style/FakeCalcButton"
            android:text="÷"
            android:textColor="#4ECDC4" />

        <Button
            android:id="@+id/fake_btn_mul"
            style="@style/FakeCalcButton"
            android:text="×"
            android:textColor="#4ECDC4" />

        <!-- Row 2: 7, 8, 9, - -->
        <Button android:id="@+id/fake_btn_7" style="@style/FakeCalcButton" android:text="7" />
        <Button android:id="@+id/fake_btn_8" style="@style/FakeCalcButton" android:text="8" />
        <Button android:id="@+id/fake_btn_9" style="@style/FakeCalcButton" android:text="9" />
        <Button android:id="@+id/fake_btn_sub" style="@style/FakeCalcButton"
            android:text="−" android:textColor="#4ECDC4" />

        <!-- Row 3: 4, 5, 6, + -->
        <Button android:id="@+id/fake_btn_4" style="@style/FakeCalcButton" android:text="4" />
        <Button android:id="@+id/fake_btn_5" style="@style/FakeCalcButton" android:text="5" />
        <Button android:id="@+id/fake_btn_6" style="@style/FakeCalcButton" android:text="6" />
        <Button android:id="@+id/fake_btn_add" style="@style/FakeCalcButton"
            android:text="+" android:textColor="#4ECDC4" />

        <!-- Row 4: 1, 2, 3, = -->
        <Button android:id="@+id/fake_btn_1" style="@style/FakeCalcButton" android:text="1" />
        <Button android:id="@+id/fake_btn_2" style="@style/FakeCalcButton" android:text="2" />
        <Button android:id="@+id/fake_btn_3" style="@style/FakeCalcButton" android:text="3" />
        <Button android:id="@+id/fake_btn_eq" style="@style/FakeCalcButton"
            android:text="=" android:textColor="#FFFFFF"
            android:backgroundTint="#4ECDC4" />

        <!-- Row 5: 0 (span 2) -->
        <Button android:id="@+id/fake_btn_0" style="@style/FakeCalcButton"
            android:text="0"
            android:layout_columnSpan="2"
            android:layout_gravity="fill" />

        <!-- 占位 -->
        <Space style="@style/FakeCalcButton" />
        <Space style="@style/FakeCalcButton" />

    </GridLayout>

</LinearLayout>
