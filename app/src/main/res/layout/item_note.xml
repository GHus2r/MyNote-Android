<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="3dp">

    <!-- 主内容（底层） -->
    <FrameLayout
        android:id="@+id/note_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:translationX="0dp">

        <!-- 真玻璃卡片背景 -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/note_card_glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:orientation="horizontal">

            <!-- 多选复选框 -->
            <View
                android:id="@+id/checkbox"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:visibility="gone"
                android:background="@drawable/checkbox_bg" />

            <!-- 文本区 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />

                <!-- 时间 -->
                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 置顶按钮 -->
    <LinearLayout
        android:id="@+id/swipe_pin"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="64dp"
        android:gravity="center"
        android:background="@drawable/bg_swipe_pin"
        android:clickable="true"
        android:focusable="true"
        android:translationX="64dp">

        <TextView
            android:id="@+id/tv_pin_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="置顶"
            android:textSize="13sp"
            android:textColor="@color/black" />
    </LinearLayout>

    <!-- 删除按钮 -->
    <LinearLayout
        android:id="@+id/swipe_delete"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="center"
        android:background="@drawable/bg_swipe_delete"
        android:clickable="true"
        android:focusable="true"
        android:translationX="64dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="删除"
            android:textSize="13sp"
            android:textColor="@color/white" />
    </LinearLayout>

</FrameLayout>
