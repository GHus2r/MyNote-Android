<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A1A">

    <!-- 顶部工具栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:background="#2A2A2A"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ia_back"
            android:layout_width="40dp" android:layout_height="40dp"
            android:gravity="center" android:text="✓ 完成"
            android:textColor="#4CAF50" android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true" />

        <TextView
            android:id="@+id/ia_mode"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="箭头 ↑"
            android:textColor="#E0E0E0"
            android:textSize="14sp" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <View
            android:id="@+id/ia_color"
            android:layout_width="28dp" android:layout_height="28dp"
            android:layout_marginHorizontal="6dp"
            android:background="#FF0000"
            android:clickable="true" android:focusable="true" />

        <TextView
            android:id="@+id/ia_arrow"
            android:layout_width="40dp" android:layout_height="40dp"
            android:gravity="center" android:text="↑"
            android:textColor="#FF5252" android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true" />

        <TextView
            android:id="@+id/ia_circle"
            android:layout_width="40dp" android:layout_height="40dp"
            android:gravity="center" android:text="○"
            android:textColor="#64B5F6" android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true" />

        <TextView
            android:id="@+id/ia_text"
            android:layout_width="40dp" android:layout_height="40dp"
            android:gravity="center" android:text="T"
            android:textColor="#E0E0E0" android:textStyle="bold" android:textSize="16sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true" />

        <TextView
            android:id="@+id/ia_redo"
            android:layout_width="40dp" android:layout_height="40dp"
            android:gravity="center" android:text="↩"
            android:textColor="#FFB74D" android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true"
            android:contentDescription="撤销" />
    </LinearLayout>

    <!-- 图片显示区 -->
    <ImageView
        android:id="@+id/ia_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter" />
</LinearLayout>
