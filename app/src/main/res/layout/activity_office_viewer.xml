<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- ═══════════════ 主工具栏 ═══════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:elevation="2dp">

        <!-- 返回 -->
        <TextView
            android:id="@+id/btn_office_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#555"
            android:textSize="20sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="返回" />

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_office_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="文档预览"
            android:textColor="#333"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 查看模式按钮组（编辑时隐藏） -->
        <LinearLayout
            android:id="@+id/view_buttons"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_search"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="🔍"
                android:textSize="16sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="搜索" />

            <TextView
                android:id="@+id/btn_copy"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="📋"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="复制" />

            <TextView
                android:id="@+id/btn_text_color"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="🎨"
                android:textSize="15sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="主题" />

            <TextView
                android:id="@+id/btn_zoom_out"
                android:layout_width="32dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="A⁻"
                android:textSize="13sp"
                android:textColor="#777"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="缩小" />

            <TextView
                android:id="@+id/btn_zoom_in"
                android:layout_width="32dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="A⁺"
                android:textSize="13sp"
                android:textColor="#777"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="放大" />

            <TextView
                android:id="@+id/btn_fit_width"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="↔"
                android:textSize="15sp"
                android:textColor="#1976D2"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="适应宽度" />
        </LinearLayout>

        <!-- 编辑切换 -->
        <TextView
            android:id="@+id/btn_edit_mode"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✏️"
            android:textSize="15sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="编辑" />
    </LinearLayout>

    <!-- ═══════════════ 编辑工具栏（编辑模式显示） ═══════════════ -->
    <LinearLayout
        android:id="@+id/edit_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:background="#EEF2FF"
        android:orientation="horizontal"
        android:elevation="1dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_edit_done"
            android:layout_width="52dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="✓ 完成"
            android:textSize="13sp"
            android:textColor="#1565C0"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#D0D0E0"
            android:layout_marginHorizontal="6dp" />

        <TextView
            android:id="@+id/btn_edit_bold"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="B"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#444"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="加粗" />

        <TextView
            android:id="@+id/btn_edit_italic"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="I"
            android:textSize="15sp"
            android:textStyle="italic"
            android:textColor="#444"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="斜体" />

        <TextView
            android:id="@+id/btn_edit_underline"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="U̲"
            android:textSize="14sp"
            android:textColor="#444"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="下划线" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#D0D0E0"
            android:layout_marginHorizontal="6dp" />

        <TextView
            android:id="@+id/btn_edit_font_down"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="A⁻"
            android:textSize="14sp"
            android:textColor="#444"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="缩小字号" />

        <TextView
            android:id="@+id/btn_edit_font_up"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="A⁺"
            android:textSize="14sp"
            android:textColor="#444"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="放大字号" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="#D0D0E0"
            android:layout_marginHorizontal="8dp" />

        <TextView
            android:id="@+id/btn_edit_export"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📤 导出"
            android:textSize="13sp"
            android:textColor="#1565C0"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ═══════════════ PPT 幻灯片导航 ═══════════════ -->
    <LinearLayout
        android:id="@+id/ppt_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:elevation="1dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_prev_slide"
            android:layout_width="44dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="◀"
            android:textSize="16sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_rounded_btn"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="上一页" />

        <TextView
            android:id="@+id/tv_slide_counter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1 / 1"
            android:textColor="#666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_next_slide"
            android:layout_width="44dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="▶"
            android:textSize="16sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_rounded_btn"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="下一页" />
    </LinearLayout>

    <!-- ═══════════════ 进度条 ═══════════════ -->
    <ProgressBar
        android:id="@+id/progress_office"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:indeterminateTint="#2196F3" />

    <!-- ═══════════════ WebView ═══════════════ -->
    <WebView
        android:id="@+id/web_office"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
